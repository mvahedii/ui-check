{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI Check M1 synthetic design snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "version", "frameId", "unit", "width", "height", "referencePNG", "parent", "child"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": { "const": "synthetic" },
    "version": { "$ref": "#/$defs/id" },
    "frameId": { "$ref": "#/$defs/id" },
    "unit": { "const": "figma-px" },
    "width": { "$ref": "#/$defs/viewport" },
    "height": { "$ref": "#/$defs/viewport" },
    "referencePNG": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}\\.png$" },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "testId", "y", "height", "topBorder"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "testId": { "$ref": "#/$defs/testId" },
        "y": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "topBorder": { "type": "number", "minimum": 0 }
      }
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parentId", "testId", "y", "height"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "parentId": { "$ref": "#/$defs/id" },
        "testId": { "$ref": "#/$defs/testId" },
        "y": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "testId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}$" },
    "viewport": { "type": "integer", "minimum": 1, "maximum": 4096 }
  }
}
